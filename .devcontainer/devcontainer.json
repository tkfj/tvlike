{
    "name": "TV-Rec PHP-Direct",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    "service": "app",
    "workspaceFolder": "/var/www/html",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "alexcvzz.vscode-sqlite"
            ]
        }
    },
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "PHP Built-in Server",
            "onAutoForward": "openBrowser" 
        }
    },
    "remoteUser": "root"
}